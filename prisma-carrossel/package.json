{
  "name": "prisma-carrossel",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "PRISMA Studio — Carrosséis: aplicativo local para criar, editar e exportar carrosséis.",
  "scripts": {
    "iniciar": "node servidor/index.js",
    "dev:studio": "vite --config studio/vite.config.ts",
    "build:studio": "tsc -p studio/tsconfig.json --noEmit && vite build --config studio/vite.config.ts",
    "build": "node src/build.js",
    "validar": "node src/validate.js",
    "teste:e2e": "node testes/e2e.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.2.5",
    "@fontsource-variable/inter": "5.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "vite": "6.3.5",
    "@vitejs/plugin-react": "4.4.1",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "playwright": "1.56.1",
    "pdfjs-dist": "4.10.38",
    "express": "4.21.2",
    "yazl": "2.5.1"
  }
}
