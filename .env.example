# ============================================================
# CONFIGURAÇÕES DE PRODUÇÃO — PROJETO GÊNESIS
# ============================================================

# Domain & Subdomain Configuration
GENESIS_SUBDOMAIN="genesis.seu-dominio.com"
APP_URL="https://genesis.seu-dominio.com"
PUBLIC_APP_URL="https://genesis.seu-dominio.com"
WEBHOOK_BASE_URL="https://genesis.seu-dominio.com"
PORT=3000
NODE_ENV="production"

# Database Configuration (MySQL Hostinger / VPS)
DB_HOST="mysql-server-host-ou-ip"
DB_PORT=3306
DB_USER="genesis_db_user"
DB_PASSWORD="sua_senha_segura_do_mysql"
DB_NAME="projeto_genesis_db"

# Gemini AI API Key
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Mercado Pago Credentials (Production / Sandbox)
MERCADOPAGO_ACCESS_TOKEN="APP_USR-seu-access-token-do-mercadopago"
MERCADOPAGO_PUBLIC_KEY="APP_USR-sua-public-key-do-mercadopago"

# Administrative Credentials & Security
ADMIN_EMAIL="admin@seu-dominio.com"
ADMIN_PASSWORD="sua_senha_forte_de_admin"
SESSION_SECRET="uma_chave_secreta_longa_e_aleatoria_para_hash_de_sessoes"
